# ============================================================
# Скопируй этот файл в .env и заполни все значения
# cp .env.example .env
# ============================================================

# Bot credentials
BOT_TOKEN=                        # Получить у @BotFather в Telegram
OWNER_ID=                         # Твой Telegram user ID (числовой)

# Telegram chat IDs
MASTER_CHANNEL_ID=                # ID основного канала (отрицательное число)
CONTROL_PANEL_CHAT_ID=            # ID чата управления (отрицательное число)

# PostgreSQL
# Придумай сложный пароль и вставь сюда И в строку DATABASE_URL ниже
DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://botuser:ТВОЙ_ПАРОЛЬ@db:5432/botf_db

# Sightengine API (https://sightengine.com)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Censorship settings
DEVICE=cpu                        # cpu или cuda
TOXICITY_THRESHOLD=0.7
NSFW_THRESHOLD=0.35

# Analytics hub channel
ANALYTICS_HUB_CHANNEL_ID=        # ID канала аналитики (отрицательное число)
ANALYTICS_HUB_CHANNEL_USERNAME=  # @username канала (без @)

# Broadcaster rate limit (messages per second, Telegram max is 30)
BROADCAST_RATE_LIMIT=15

# Media group collect delay (seconds)
MEDIA_GROUP_DELAY=1.0

# Daily report time (HH:MM, UTC)
DAILY_REPORT_TIME=09:00

# Weekly backup day (0=Monday, 6=Sunday)
BACKUP_DAY_OF_WEEK=0
